# Скопируйте в .env для локального запуска (на Render переменные задаются в панели)
APP_NAME=Stream Post API
ENVIRONMENT=development

# Адреса, с которых frontend может обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL. Пока можно оставить пустым — приложение работает и без базы.
# Пример: postgresql://user:password@localhost:5432/stream_post
DATABASE_URL=
